DB_NAME=dev_first_door
DB_USER=dev_first_door
DB_PASSWORD=troque_esta_senha

BACKEND_PORT=8080
FRONTEND_PORT=3000

# Coleta da busca pública do LinkedIn (sem login, ignora o robots.txt deles). Só para uso pessoal.
LINKEDIN_ENABLED=false

# Conta admin criada/sincronizada no banco ao subir. Sem senha nenhum admin é criado.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Cadastro público de contas (papel USUARIO) em POST /api/conta.
CADASTRO_ABERTO=true

# Adaptação de currículo por vaga com IA (OpenAI). Sem chave, só a adaptação fica desligada.
# A chave fica apenas no backend; o modelo precisa suportar Structured Outputs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Adaptações por conta a cada 24 horas (cada uma faz até duas chamadas à API).
IA_LIMITE_DIARIO=10

# Fuso horário do backend (as datas do painel e da página são exibidas nesse horário).
TZ=America/Sao_Paulo
